{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Handoff Contract exchange reply v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "exchange_id", "offer_sha256", "format", "body"],
  "properties": {
    "schema_version": {"const": 1},
    "exchange_id": {"type": "string", "pattern": "\\S"},
    "offer_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "format": {"type": "string", "pattern": "\\S"},
    "body": {"type": "string", "pattern": "\\S"},
    "suggested_question": {"type": "string", "pattern": "\\S"}
  }
}
